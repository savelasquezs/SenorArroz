# Google Maps Platform - credenciales exclusivas del backend
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
STOREFRONT_KEY_ID=web-main
STOREFRONT_KEY_HASH=

# Habilitar Geocoding API y restringir esta clave a ese servicio.
GOOGLE_MAPS_GEOCODING_API_KEY=

# Habilitar Routes API y restringir esta clave a ese servicio.
GOOGLE_MAPS_ROUTES_API_KEY=

# Rappi API v2 sandbox - secretos solo en variables de entorno
Rappi__ClientId=
Rappi__ClientSecret=
Rappi__AuthUrl=https://api.dev.rappi.com/restaurants/auth/v1/token/login/integrations
Rappi__ApiBaseUrl=https://api.dev.rappi.com/api/v2/restaurants-integrations-public-api

# URL publica estable usada para registrar webhooks
ApiPublic__BaseUrl=https://senorarrozapi.up.railway.app

# Meta Conversions API. El token nunca debe exponerse al frontend.
META_PIXEL_ID=1941546679814779
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v25.0
META_EVENT_SOURCE_URL=https://senorarroz.com
# Solo durante validación en Events Manager; quitar después de probar.
META_CAPI_TEST_EVENT_CODE=

# Clave de 32 bytes en Base64 para cifrar un secreto distinto por webhook
Integrations__EncryptionKey=
